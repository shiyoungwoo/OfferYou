# ============================================================
# OfferYou — 环境变量说明
# 复制本文件为 .env.local 并填入真实值
# ============================================================

# --- 模型 Provider 选择 ---
# 可选值: gemini | openai_compatible
DEFAULT_MODEL_PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL_SIMPLE=gemini-2.5-flash
# GEMINI_MODEL_COMPLEX=gemini-2.5-pro
# GEMINI_MODEL_VISION=gemini-2.5-flash

# --- MiMo (OpenAI 兼容) ---
# MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL_SIMPLE=mimo-v2.5
# MIMO_MODEL_COMPLEX=mimo-v2.5-pro
# MIMO_MODEL_VISION=mimo-v2.5

# --- 通用 OpenAI 兼容 ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# --- OpenAI Codex OAuth ---
# OPENAI_COMPATIBLE_FLAVOR=openai_codex
# OPENAI_CODEX_ACCESS_TOKEN=
# OPENAI_CODEX_BASE_URL=https://api.openai.com/v1
# OPENAI_CODEX_MODEL_SIMPLE=gpt-4o-mini
# OPENAI_CODEX_MODEL_COMPLEX=gpt-4o

# --- PDF 混合解析（可选）---
# OFFERYOU_PDF_HYBRID=0
# OFFERYOU_PDF_HYBRID_URL=http://localhost:5002

# --- 调试开关 ---
# OFFERYOU_DEBUG_EXPORT=1
# OFFERYOU_DEBUG_INGESTION=1
