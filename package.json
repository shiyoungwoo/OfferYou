{
  "name": "offeryou-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --exclude 'tests/integration/export/**' --exclude 'tests/integration/job-apply/job-apply-pdf-export.test.ts' --exclude 'tests/integration/job-apply/job-apply-interview-prep.test.ts' --exclude 'tests/integration/job-apply/job-apply-quality.test.ts'",
    "test:pdf": "vitest run tests/integration/export/pdf-export-service.test.ts tests/integration/export/resume-export-service.test.ts tests/integration/job-apply/job-apply-pdf-export.test.ts tests/integration/job-apply/job-apply-interview-prep.test.ts tests/integration/job-apply/job-apply-quality.test.ts --pool forks --maxWorkers 1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "export:fixtures": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/export-job-apply-fixtures.mjs",
    "report:self-use": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/run-self-use-beta-report.mjs",
    "report:real-trial": "node --experimental-transform-types --import ./scripts/register-alias.mjs scripts/run-real-self-use-trial.mjs",
    "check:vnext": "node scripts/check-vnext-mvp.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^1.0.0",
    "next": "^15.2.3",
    "pdf-parse": "1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
