{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-schema/main/tauri.conf.json",
  "productName": "OfferYou",
  "version": "0.1.0",
  "identifier": "com.offeryou.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --hostname 127.0.0.1 --port 3100",
    "devUrl": "http://127.0.0.1:3100",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "static"
  },
  "app": {
    "windows": [
      {
        "title": "OfferYou",
        "url": "http://127.0.0.1:3100",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
